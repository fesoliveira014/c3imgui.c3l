// --- hand-written shims ---
// ---- ImVec2/ImVec4 → C3 short-vector aliases ----
// C3's `float[<2>]` and `float[<4>]` are ABI-compatible with ImVec2 and ImVec4
// (8 and 16 bytes, passed by value, fields .x .y .z .w via swizzle). Using the
// short-vector form gives callers SIMD math operators (+, -, *, dot, length)
// for free instead of having to spell out per-field arithmetic.
alias Vec2 = float[<2>];
alias Vec4 = float[<4>];

