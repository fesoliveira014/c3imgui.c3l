// structs
struct Viewport {
    Id id;
    ViewportFlags flags;
    Vec2 pos;
    Vec2 size;
    Vec2 framebuffer_scale;
    Vec2 work_pos;
    Vec2 work_size;
    float dpi_scale;
    Id parent_viewport_id;
    Viewport* parent_viewport;
    DrawData draw_data;
    void* renderer_user_data;
    void* platform_user_data;
    void* platform_icon_data;
    void* platform_handle;
    void* platform_handle_raw;
    bool platform_window_created;
    bool platform_request_move;
    bool platform_request_resize;
    bool platform_request_close;
}
$assert Viewport::size == 120;

struct InputTextCallbackData {
    Context ctx;
    InputTextFlags event_flag;
    InputTextFlags flags;
    void* user_data;
    Id id;
    Key event_key;
    uint event_char;
    bool event_activated;
    bool buf_dirty;
    char* buf;
    int buf_text_len;
    int buf_size;
    int cursor_pos;
    int selection_start;
    int selection_end;
}
$assert InputTextCallbackData::size == 72;

struct SizeCallbackData {
    void* user_data;
    Vec2 pos;
    Vec2 current_size;
    Vec2 desired_size;
}
$assert SizeCallbackData::size == 32;

struct Payload {
    void* data;
    int data_size;
    Id source_id;
    Id source_parent_id;
    int data_frame_count;
    char[32+1] data_type;
    bool preview;
    bool delivery;
}
$assert Payload::size == 64;

struct ListClipper {
