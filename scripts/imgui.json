  "overrides": {},
  "extra": "// ---- ImVec2/ImVec4 \u2192 C3 short-vector aliases ----\n// C3's `float[<2>]` and `float[<4>]` are ABI-compatible with ImVec2 and ImVec4\n// (8 and 16 bytes, passed by value, fields .x .y .z .w via swizzle). Using the\n// short-vector form gives callers SIMD math operators (+, -, *, dot, length)\n// for free instead of having to spell out per-field arithmetic.\nalias Vec2 = float[<2>];\nalias Vec4 = float[<4>];\n\n// helpers from c3imgui.c3l/scripts/c3imgui_helpers.cpp\n// (exposes a handful of ImGuiIO fields without binding the full 116-field struct)\nextern fn void io_set_display_size(float w, float h) @cname(\"c3imgui_io_set_display_size\");\nextern fn void io_set_delta_time(float dt) @cname(\"c3imgui_io_set_delta_time\");\nextern fn void io_set_config_flags(ConfigFlags flags) @cname(\"c3imgui_io_set_config_flags\");\nextern fn ConfigFlags io_get_config_flags() @cname(\"c3imgui_io_get_config_flags\");\nextern fn void io_set_backend_flags(BackendFlags flags) @cname(\"c3imgui_io_set_backend_flags\");\nextern fn BackendFlags io_get_backend_flags() @cname(\"c3imgui_io_get_backend_flags\");\nextern fn FontAtlas io_get_fonts() @cname(\"c3imgui_io_get_fonts\");\nextern fn bool io_get_want_capture_mouse() @cname(\"c3imgui_io_get_want_capture_mouse\");\nextern fn bool io_get_want_capture_keyboard() @cname(\"c3imgui_io_get_want_capture_keyboard\");\nextern fn void io_set_ini_filename(ZString p) @cname(\"c3imgui_io_set_ini_filename\");\nextern fn bool fonts_build(FontAtlas atlas) @cname(\"c3imgui_fonts_build\");\nextern fn int draw_data_cmd_list_count(DrawData draw_data) @cname(\"c3imgui_draw_data_cmd_list_count\");\nextern fn int draw_data_total_vtx_count(DrawData draw_data) @cname(\"c3imgui_draw_data_total_vtx_count\");\nextern fn int draw_data_total_idx_count(DrawData draw_data) @cname(\"c3imgui_draw_data_total_idx_count\");\nextern fn bool draw_data_valid(DrawData draw_data) @cname(\"c3imgui_draw_data_valid\");\nextern fn uint col32(char r, char g, char b, char a) @cname(\"c3imgui_col32\");\nextern fn TextureRef texture_ref_from_id(ulong id) @cname(\"c3imgui_texture_ref_from_id\");\n\n// ---- ctor/dtor shims for ImVector-bearing opaques ----\nmodule imgui::text_filter;\nextern fn TextFilter new_() @cname(\"c3imgui_text_filter_new\");\nextern fn TextFilter new_with_default(ZString default_filter) @cname(\"c3imgui_text_filter_new_with_default\");\nextern fn void destroy(TextFilter f) @cname(\"c3imgui_text_filter_destroy\");\n\nmodule imgui::text_buffer;\nextern fn TextBuffer new_() @cname(\"c3imgui_text_buffer_new\");\nextern fn void destroy(TextBuffer b) @cname(\"c3imgui_text_buffer_destroy\");\n\nmodule imgui::selection_basic_storage;\nextern fn SelectionBasicStorage new_() @cname(\"c3imgui_selection_basic_storage_new\");\nextern fn void destroy(SelectionBasicStorage s) @cname(\"c3imgui_selection_basic_storage_destroy\");\n\nmodule imgui::draw_list_splitter;\nextern fn DrawListSplitter new_() @cname(\"c3imgui_draw_list_splitter_new\");\nextern fn void destroy(DrawListSplitter s) @cname(\"c3imgui_draw_list_splitter_destroy\");\n\nmodule imgui::font_glyph_ranges_builder;\nextern fn FontGlyphRangesBuilder new_() @cname(\"c3imgui_font_glyph_ranges_builder_new\");\nextern fn void destroy(FontGlyphRangesBuilder b) @cname(\"c3imgui_font_glyph_ranges_builder_destroy\");\n\nmodule imgui::font_config;\nextern fn FontConfig new_() @cname(\"c3imgui_font_config_new\");\nextern fn void destroy(FontConfig c) @cname(\"c3imgui_font_config_destroy\");\nextern fn void set_merge_mode(FontConfig c, bool v) @cname(\"c3imgui_font_config_set_merge_mode\");\nextern fn void set_pixel_snap_h(FontConfig c, bool v) @cname(\"c3imgui_font_config_set_pixel_snap_h\");\nextern fn void set_oversample(FontConfig c, int h, int v) @cname(\"c3imgui_font_config_set_oversample\");\nextern fn void set_size_pixels(FontConfig c, float px) @cname(\"c3imgui_font_config_set_size_pixels\");\nextern fn void set_glyph_offset(FontConfig c, float x, float y) @cname(\"c3imgui_font_config_set_glyph_offset\");\nextern fn void set_glyph_min_advance_x(FontConfig c, float v) @cname(\"c3imgui_font_config_set_glyph_min_advance_x\");\nextern fn void set_glyph_max_advance_x(FontConfig c, float v) @cname(\"c3imgui_font_config_set_glyph_max_advance_x\");\nextern fn void set_rasterizer_multiply(FontConfig c, float v) @cname(\"c3imgui_font_config_set_rasterizer_multiply\");\nextern fn void set_name(FontConfig c, ZString name) @cname(\"c3imgui_font_config_set_name\");\n",
